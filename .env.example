# Copy to .env and fill in. Never commit the real .env file.

# Generate with: docker compose run --rm --no-deps web ./bin/rails secret  (or: openssl rand -hex 64)
SECRET_KEY_BASE=

# Keep false for plain HTTP on localhost; set true behind an HTTPS proxy.
RAILS_FORCE_SSL=false
APP_HOST=localhost
APP_PORT=3000
MAILER_FROM=Patrocinios Universitarios <no-reply@example.com>

# Coordinator account created on the first boot. Leave ADMIN_PASSWORD empty to skip it (minimum 10 characters).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Load the fictional demo projects, tutors and sponsors when the database is empty.
LOAD_DEMO_DATA=true
