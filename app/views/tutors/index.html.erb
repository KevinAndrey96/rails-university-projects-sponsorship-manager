<% content_for :title, t(".title") %>

<header class="page-header">
  <div>
    <h1><%= t(".title") %></h1>
    <p class="muted"><%= t(".lead") %></p>
  </div>
  <% if authenticated? %>
    <%= link_to t(".new"), new_tutor_path, class: "button" %>
  <% end %>
</header>

<section class="card">
  <% if @page.records.any? %>
    <ul class="list">
      <% @page.records.each do |tutor| %>
        <li class="row" id="<%= dom_id(tutor) %>">
          <div class="row-main">
            <%= link_to tutor.name, tutor_path(tutor), class: "row-title" %>
            <p class="meta"><%= tutor.faculty %></p>
          </div>
          <div class="row-side"><span class="meta"><%= t(".projects", count: tutor.projects.size) %></span></div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state"><%= t(".empty") %></p>
  <% end %>
</section>

<%= render "shared/pagination", page: @page %>
