<% content_for :title, @sponsor.name %>

<header class="page-header">
  <div>
    <p class="breadcrumb"><%= link_to t("nav.sponsors"), sponsors_path %></p>
    <h1><%= @sponsor.name %></h1>
    <p class="muted">
      <%= t("sponsors.kinds.#{@sponsor.kind}") %> · NIT <%= @sponsor.nit %>
      <% if authenticated? %>
        · <%= formatted_phone(@sponsor.phone) %> · <%= mail_to @sponsor.email %>
      <% end %>
    </p>
  </div>
  <% if authenticated? %>
    <div class="header-side">
      <%= link_to t("app.edit"), edit_sponsor_path(@sponsor), class: "button button-ghost" %>
      <%= button_to t("app.destroy"), sponsor_path(@sponsor), method: :delete, class: "button button-ghost",
            form: { data: { turbo_confirm: t(".confirm_destroy", name: @sponsor.name) } } %>
    </div>
  <% end %>
</header>

<section class="kpis">
  <%= render "shared/kpi", label: t(".committed"), value: cop(@sponsorships.sum(&:amount)) %>
  <%= render "shared/kpi", label: t(".projects_title"), value: @sponsorships.size %>
</section>

<section class="card">
  <h2><%= t(".projects_title") %></h2>
  <% if @sponsorships.any? %>
    <ul class="list">
      <% @sponsorships.each do |sponsorship| %>
        <li class="row">
          <div class="row-main">
            <%= link_to sponsorship.project.title, project_path(sponsorship.project), class: "row-title" %>
            <p class="meta"><%= l(sponsorship.committed_on, format: :long) %></p>
          </div>
          <div class="row-side"><strong><%= cop(sponsorship.amount) %></strong></div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted"><%= t(".no_projects") %></p>
  <% end %>
</section>
