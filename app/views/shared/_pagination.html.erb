<% if page.total_pages > 1 %>
  <nav class="pagination" aria-label="<%= t("app.pagination.label") %>">
    <% if page.previous_page %>
      <%= link_to t("app.pagination.previous"), request.query_parameters.merge(page: page.previous_page), rel: "prev", class: "button button-ghost" %>
    <% end %>
    <span class="meta"><%= t("app.pagination.summary", page: page.number, pages: page.total_pages, count: page.total_count) %></span>
    <% if page.next_page %>
      <%= link_to t("app.pagination.next"), request.query_parameters.merge(page: page.next_page), rel: "next", class: "button button-ghost" %>
    <% end %>
  </nav>
<% end %>
